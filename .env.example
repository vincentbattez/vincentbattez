# Pushover — notif "quelqu'un essaye de me joindre" (/go/call)
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# PostHog analytics (région EU)
NUXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NUXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# OpenRouter — Entretien de recommandation (/recommendation)
# Plafond de crédit à configurer côté OpenRouter : seul garde-fou budgétaire.
OPENROUTER_API_KEY=
# Modèle surchargeable sans redéploiement (défaut : anthropic/claude-sonnet-4.5)
RECOMMENDATION_MODEL=
